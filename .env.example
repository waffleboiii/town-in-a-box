# Copy this file to `.env` (same folder) and paste your keys after the = signs.
# `.env` is git-ignored: it never gets committed or published.

# Nebius Token Factory — https://tokenfactory.nebius.com (API keys page)
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Models (defaults are fine; verify the exact IDs on the Token Factory models page)
MODEL_REACTION=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_CONVERSATION=nvidia/nemotron-3-super-120b-a12b
MODEL_SYNTHESIS=nvidia/Nemotron-3-Ultra-550b-a55b

# Rate limits from your Token Factory console (requests / tokens per minute)
LLM_RPM=60
LLM_TPM=400000
LLM_CONCURRENCY=8

# Optional — Tavily (https://tavily.com)
TAVILY_API_KEY=
